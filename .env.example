POSTGRES_DB=avto_intellect
POSTGRES_USER=avto
POSTGRES_PASSWORD=
AUTH_SECRET=
HTTP_PORT=8080
HTTPS_ONLY=0
# Compose routes mail to Mailpit. Open http://localhost:8025 to read it.
# For an external SMTP provider, set the host, sender, port and credentials.
# SMTP_SECURITY supports none (local), starttls (usually 587), or ssl (usually 465).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@avto-intellect.local
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
# Set a unique MinIO password of at least 8 characters.
MINIO_ROOT_USER=avto
MINIO_ROOT_PASSWORD=
